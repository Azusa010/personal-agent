{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/preload/index.d.ts",
    "src/renderer/src/main.tsx"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/main/capabilities/plugins/**",
    "src/main/product-state/migrations/**",
    "src/renderer/src/components/a2ui/**"
  ],
  "ignoreExportsUsedInFile": true
}
