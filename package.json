{
  "name": "personal-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --dir apps/desktop start",
    "typecheck": "pnpm --dir apps/desktop typecheck",
    "lint:ts": "pnpm --dir apps/desktop lint",
    "lint:py": "uv run --project services/agent-runtime --locked ruff check .",
    "fix:py": "services/agent-runtime/.venv/Scripts/python.exe -m ruff check . --fix",
    "test:pack": "pnpm --dir packages/protocol test",
    "test:ts": "pnpm --dir apps/desktop test",
    "test:py": "uv run --project services/agent-runtime --locked pytest",
    "test": "pnpm test:pack && pnpm test:ts && pnpm test:py",
    "build": "pnpm --dir apps/desktop build",
    "verify": "pnpm typecheck && pnpm lint:ts && pnpm lint:py && pnpm test",
    "verify:all": "pnpm verify && pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
